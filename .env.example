# ===== WAJIB =====
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/magot"
# String acak minimal 32 karakter, contoh generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG"

# ===== Layanan AI (project MAGGOT_PREDICTION) =====
# Base URL API prediksi (VERSI 2/api/api_server.py, default port 5000) TANPA path
ML_BASE_URL="http://localhost:5000"
ML_TIMEOUT_MS=15000
# Base URL chatbot (VERSI 2/chatbot/chatbot_api.py). Default chatbot port 5001 bentrok
# dengan PORT backend di bawah, jadi jalankan chatbot dengan FLASK_PORT=5002
CHATBOT_BASE_URL="http://localhost:5002"
CHATBOT_TIMEOUT_MS=60000

# ===== Server =====
PORT=5001
# Isi 1 jika server di belakang reverse proxy (nginx/cloudflare) supaya rate limit pakai IP asli
TRUST_PROXY=1
# Origin web yang boleh akses (pisah koma). Kosongkan = semua origin. Android tidak terpengaruh.
CORS_ORIGIN=
# URL yang tampil di Swagger
API_BASE_URL="https://api.smartmaggot.my.id"
# true untuk mematikan /api-docs di production
DISABLE_SWAGGER=false

# ===== Rate limit (opsional, ini nilai bawaan) =====
# Dibuat longgar per IP karena saat demo banyak HP warga memakai wifi yang sama (1 IP).
# Request total per menit per IP
RATE_LIMIT_GLOBAL_PER_MIN=3000
# Registrasi per jam per IP
RATE_LIMIT_REGISTER_PER_HOUR=300
# Login GAGAL per 15 menit untuk 1 username dari 1 IP (salah ketik 1 orang tidak memblokir orang lain)
RATE_LIMIT_LOGIN_FAIL_PER_ACCOUNT=10
# Login GAGAL per 15 menit per IP (semua username), rem brute force
RATE_LIMIT_LOGIN_FAIL_PER_IP=300
# Pertanyaan chatbot per menit per sesi login
RATE_LIMIT_CHATBOT_PER_MIN=20
